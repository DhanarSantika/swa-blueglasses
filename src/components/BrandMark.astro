---
interface Props {
  variant?: 'small' | 'hero';
}

const { variant = 'small' } = Astro.props;
---

<span class:list={['brand-mark', `brand-mark-${variant}`]} aria-hidden="true">
  <img class="brand-logo brand-logo-dark" src="/logo-dark.svg" alt="" />
  <img class="brand-logo brand-logo-light" src="/logo-light.svg" alt="" />
</span>
